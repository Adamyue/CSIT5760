{
  "name": "safetrade-escrow",
  "version": "1.0.0",
  "private": true,
  "description": "SafeTrade smart-contract escrow with delivery and review deadlines",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:sepolia:web3": "python scripts/deploy_web3.py",
    "verify:etherscan": "python scripts/verify_etherscan.py",
    "demo:local": "hardhat run scripts/demo.js --network hardhat",
    "demo:sepolia": "hardhat run scripts/demo.js --network sepolia",
    "demo:sepolia:web3": "python scripts/demo_web3.py",
    "security": "powershell -ExecutionPolicy Bypass -File scripts/security-analysis.ps1",
    "verify:workflow": "powershell -ExecutionPolicy Bypass -File scripts/verify-workflow.ps1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.4",
    "@openzeppelin/contracts": "5.6.1",
    "chai": "4.5.0",
    "dotenv": "17.2.3",
    "ethers": "6.17.0",
    "hardhat": "2.29.2",
    "solc": "0.8.28",
    "solidity-coverage": "0.8.17"
  },
  "overrides": {
    "serialize-javascript": "7.1.4",
    "tmp": "0.2.7"
  }
}
